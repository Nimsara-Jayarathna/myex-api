{
  "name": "blipzo-api",
  "version": "2.0.0",
  "description": "Blipzo API migrated to a NestJS modular monolith with public versioned APIs and internal admin APIs.",
  "private": true,
  "license": "ISC",
  "scripts": {
    "start": "nest start",
    "start:dev": "node scripts/run.mjs dev",
    "start:debug": "node scripts/run.mjs debug",
    "start:release": "node scripts/run.mjs release",
    "start:release:debug": "node scripts/run.mjs release-debug",
    "start:prod": "npm run start:release",
    "prepare": "node scripts/prepare-husky.mjs",
    "dev": "npm run start:dev",
    "debug": "npm run start:debug",
    "release": "npm run lint && npm run format:check && npm run test && npm run build",
    "live:release": "npm run build && npm run start:release",
    "live:debug": "npm run build && npm run start:release:debug",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:create": "tsx src/database/migration-runner.ts create",
    "migration:up": "tsx src/database/migration-runner.ts up",
    "migration:down": "tsx src/database/migration-runner.ts down",
    "migration:status": "tsx src/database/migration-runner.ts status",
    "seed:admin": "tsx src/database/seeders/seed-admin-user.ts",
    "seed:currencies": "tsx src/database/seeders/seed-currencies.ts",
    "seed:categories": "tsx src/database/seeders/seed-default-categories.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "node-cron": "^4.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sib-api-v3-sdk": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.0.0",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
