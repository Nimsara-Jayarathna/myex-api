NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
DEBUG_LOG_BODY=false
MONGO_URI=mongodb://localhost:27017/blipzo
MONGO_AUTO_INDEX=false
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
ADMIN_SEED_EMAIL=admin@blipzo.local
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_IP_ALLOWLIST=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@blipzo.local
BREVO_SENDER_NAME=Blipzo
